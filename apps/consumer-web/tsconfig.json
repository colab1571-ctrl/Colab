{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "composite": false,
    "incremental": false,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@colab/ui": [
        "../../packages/ui/src/index.ts"
      ],
      "@colab/i18n": [
        "../../packages/i18n/src/loader.ts"
      ],
      "@colab/api-types/*": [
        "../../packages/api-types/*"
      ]
    },
    "allowJs": true,
    "noEmit": true,
    "isolatedModules": true
  },
  "include": [
    "next.config.ts",
    "sentry.*.config.ts",
    "src",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
